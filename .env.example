APP_ENV=dev
LOG_LEVEL=INFO
AWS_REGION=us-east-1
# Optional for local development if you use a named AWS CLI profile:
# AWS_PROFILE=your-profile
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_MAX_TOKENS=700
BEDROCK_TEMPERATURE=0.1
BEDROCK_TOP_P=0.9

# Stage 2: populate these from Terraform outputs after deployment.
BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_RAG_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-lite-v1:0

